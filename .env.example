# Kopiere diese Datei als ".env" und fülle die Werte aus.
# Andere Variablen lassen sich mit ${NAME} einsetzen (Windows-Variablen wie %USERPROFILE% funktionieren ebenfalls).
# Achtung: In "..." werden \n, \t usw. als Steuerzeichen gelesen – bei Ordnern wie \neu oder \tom
# daher doppelte Backslashes (C:\\Users\\tom) oder Schrägstriche (C:/Users/tom) verwenden.

# Übergeordneter Ordner für das Projekt
FOLDER_PATH="C:\Dein\Pfad\Depotaufteilung"

# Ordner, in dem die heruntergeladenen iShares-CSV-Dateien gespeichert werden
DOWNLOAD_PATH="${FOLDER_PATH}\downloadfiles"

# Ordner für die Ergebnisse (HTML-Report portfolio_report.html)
SAVE_PATH="${FOLDER_PATH}\outputfiles"

# Pfad zur Depot-Excel-Datei (Eingabe)
INPUT_FILE="${FOLDER_PATH}\portfolio.xlsx"

# Pfad zur Ergebnis-Excel-Datei (Ausgabe)
OUTPUT_FILE="${SAVE_PATH}\stockoverview.xlsx"

# Kommagetrennte Liste der iShares-CSV-Download-URLs
# Format seit 2026: .../produkte/<id>/<fondsname>/latest-holdings.csv
CSV_URL="https://www.ishares.com/de/privatanleger/de/produkte/290846/ishares-msci-world-sri-ucits-etf/latest-holdings.csv"

# Dateinamen für die heruntergeladenen CSVs (gleiche Reihenfolge wie CSV_URL).
# Der Name ohne ".csv" muss exakt der Spalte "Position" in portfolio.xlsx entsprechen.
ETF_CSV_FILE="iShares MSCI World SRI ETF.csv"

# Suffixe für Aktien/ETFs auf Yahoo Finance (kommagetrennt, der Reihe nach probiert).
# Nur Euro-Börsen verwenden – Kurse werden NICHT in Euro umgerechnet.
STOCK_TICKER_SUFFIXES=".DE,.F"

# Suffixe für Kryptowährungen auf Yahoo Finance (nur -EUR, siehe oben)
CRYPTO_TICKER_SUFFIXES="-EUR"
